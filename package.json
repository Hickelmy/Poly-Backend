{
  "name": "polys-backend",
  "version": "1.0.0",
  "description": "Backend Polys com NestJS e Prisma",
  "author": "",
  "license": "PROPRIETARY",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "----------- DEV (porta 3001, DB polys_dev:5432, Redis:6379) -----------": "",
    "dev": "cross-env NODE_ENV=development nest start --watch",
    "dev:db": "dotenv -e .env.development -- npx prisma generate && dotenv -e .env.development -- npx prisma migrate dev && npm run dev",
    "dev:reset": "dotenv -e .env.development -- npx prisma migrate reset --force && npm run dev:db",
    "dev:studio": "dotenv -e .env.development -- npx prisma studio",
    "dev:seed": "dotenv -e .env.development -- npx prisma db seed",
    "----------- STAGING (porta 3002, DB polys_staging:5433, Redis:6380) -----------": "",
    "staging": "cross-env NODE_ENV=staging nest start --watch",
    "staging:build": "cross-env NODE_ENV=staging nest build",
    "staging:start": "cross-env NODE_ENV=staging node dist/main.js",
    "staging:db": "dotenv -e .env.staging -- npx prisma generate && dotenv -e .env.staging -- npx prisma migrate dev",
    "staging:migrate": "dotenv -e .env.staging -- npx prisma migrate deploy",
    "staging:studio": "dotenv -e .env.staging -- npx prisma studio",
    "----------- PRODUCTION (porta 3003, DB polys_production:5434, Redis:6381) -----------": "",
    "prod:build": "cross-env NODE_ENV=production nest build",
    "prod:start": "cross-env NODE_ENV=production node dist/main.js",
    "prod:migrate": "dotenv -e .env.production -- npx prisma migrate deploy",
    "prod:studio": "dotenv -e .env.production -- npx prisma studio",
    "----------- DOCKER (ambientes isolados) -----------": "",
    "docker:dev": "docker compose -f ../docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f ../docker-compose.dev.yml down",
    "docker:dev:reset": "docker compose -f ../docker-compose.dev.yml down -v",
    "docker:staging": "docker compose -f ../docker-compose.staging.yml up -d --build",
    "docker:staging:down": "docker compose -f ../docker-compose.staging.yml down",
    "docker:staging:reset": "docker compose -f ../docker-compose.staging.yml down -v",
    "docker:prod": "docker compose -f ../docker-compose.prod.yml --env-file ../.env.prod up -d --build",
    "docker:prod:down": "docker compose -f ../docker-compose.prod.yml down",
    "start:docker": "npx prisma db push --skip-generate && node dist/main.js",
    "----------- PRISMA (genéricos) -----------": "",
    "prisma:generate": "npx prisma generate"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.2.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/throttler": "^5.0.0",
    "@prisma/client": "^5.22.0",
    "@sentry/nestjs": "^10.42.0",
    "@supabase/supabase-js": "^2.45.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.4.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^6.27.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^10.0.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^10.0.0",
    "baseline-browser-mapping": "^2.10.0",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.4.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.1.0",
    "jest": "^29.7.0",
    "pg": "^8.20.0",
    "prettier": "^3.0.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
