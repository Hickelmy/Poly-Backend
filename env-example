NODE_ENV=development
PORT=3001

# =============================================
# DATABASE - Supabase (PostgreSQL + PostGIS)
# =============================================
DATABASE_URL="postgresql://postgres.[REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?schema=public"

# =============================================
# SUPABASE (Storage, Realtime, etc.)
# =============================================
SUPABASE_URL="https://[REF].supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# =============================================
# REDIS (Cache + BullMQ + Feature Flags)
# =============================================
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# =============================================
# JWT - Access Token (curto) + Refresh Token (longo)
# =============================================
JWT_SECRET="GERE-UMA-CHAVE-SEGURA-DE-256-BITS"
JWT_ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# =============================================
# FIREBASE (Google Login)
# =============================================
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# =============================================
# CRIPTOGRAFIA
# =============================================
ENCRYPTION_MASTER_KEY="GERE-COM-openssl-rand-base64-32"

# =============================================
# CORS & URLs
# =============================================
CORS_ORIGIN=*
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:3001"

# =============================================
# CAPTCHA (reCAPTCHA v3)
# =============================================
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_MIN_SCORE=0.5

# =============================================
# SENTRY (Error Tracking)
# =============================================
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================================
# CLOUDFLARE (CDN)
# =============================================
# Configure o domínio no Cloudflare Dashboard.
# O Cloudflare atua como proxy reverso (CDN).
# Variáveis usadas para purge de cache:
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_API_TOKEN=""

# =============================================
# PAGAMENTOS
# =============================================
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# PUBLIC_KEY=APP_USR-... (Mercado Pago)
# ACESS_TOKEN=APP_USR-... (Mercado Pago)

# =============================================
# OPENAI (Moderação de conteúdo - texto e imagens)
# =============================================
OPENAI_API_KEY=sk-...

# =============================================
# LOGGING
# =============================================
LOG_LEVEL=debug
