generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("USER")
  avatarUrl    String?
  bannerUrl    String?
  pixKeyRandom String?
  pixKeyPhone  String?
  pixKeyEmail  String?
  pixKeyCpf    String?
  phone        String?
  cep          String?
  state        String?
  city         String?
  neighborhood String?
  street       String?
  houseNumber  String?
  
  // Residence location
  residenceLat    Float?
  residenceLng    Float?
  residenceZoneId String?
  residenceZone   Zone?    @relation("UserResidenceZone", fields: [residenceZoneId], references: [id])
  
  // Current zone (for tracking)
  currentZoneId   String?
  currentZone     Zone?    @relation("UserCurrentZone", fields: [currentZoneId], references: [id])
  
  // News relations
  authoredNews    News[]        @relation("NewsAuthor")
  newsLikes       NewsLike[]    @relation("UserNewsLikes")
  newsComments    NewsComment[] @relation("UserNewsComments")
  newsReports     NewsReport[]  @relation("UserNewsReports")
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Zonas/Áreas da comunidade
model Zone {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String?  @default("#14b8a6")
  active      Boolean  @default(true)
  
  // Polygon coordinates in GeoJSON format
  polygonGeojson Json?
  
  // Center point for quick reference
  centerLat   Float?
  centerLng   Float?
  
  // Relations
  residenceUsers User[] @relation("UserResidenceZone")
  currentUsers   User[] @relation("UserCurrentZone")
  products       Product[]
  services       Service[]
  projects       Project[]
  news           News[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id             String           @id @default(cuid())
  title          String
  shortDescription String?
  description    String?
  category       String?
  status         String           @default("proposed")
  imageUrl       String?
  evidences      String[]         @default([])

  targetAmount   Float            @default(0)
  currentAmount  Float            @default(0)
  minVotes       Int              @default(10)
  votesCount     Int              @default(0)
  fundingDeadline DateTime?

  ownerId        String?
  ownerEmail     String?

  locationAddress String?
  latitude        Float?
  longitude       Float?
  
  // Zone/Area association
  zoneId         String?
  zone           Zone?            @relation(fields: [zoneId], references: [id])

  expensesTotal  Float            @default(0)

  expenses       ProjectExpense[]
  votes          ProjectVote[]
  payments       ProjectPayment[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ProjectExpense {
  id          String   @id @default(cuid())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String

  type        String
  description String?
  cost        Float
  quantity    Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectVote {
  id         String   @id @default(cuid())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String

  userId     String?
  userEmail  String?
  type       String   @default("up") // 'up' ou 'down'

  createdAt  DateTime @default(now())
}

model ProjectPayment {
  id               String   @id @default(cuid())
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId        String

  userId           String?
  userEmail        String?

  amount           Float
  commissionAmount Float?  @default(0)
  paymentMethod    String
  status           String
  isSubscription   Boolean @default(false)
  anonymous        Boolean @default(false)
  transactionId    String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AppSettings {
  id             Int      @id @default(1)
  maintenanceMode Boolean @default(false)
  openSignup      Boolean @default(true)
  dailySummary    Boolean @default(true)
  defaultLocale   String  @default("pt-BR")
  updatedAt       DateTime @updatedAt
}

model ApiToken {
  id          String   @id @default(cuid())
  name        String   // Nome do serviço (ex: "Abacate Pay", "Stripe")
  provider    String   // Identificador do provedor (ex: "abacate_pay", "stripe")
  token       String   // Token da API (criptografado em produção)
  description String?  // Descrição opcional
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) // Ordem de exibição
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id                String   @id @default(cuid())
  title             String
  description       String?
  price             Float
  quantityAvailable Int      @default(0)
  category          String?
  condition         String?  // novo, usado_otimo, etc.
  unitType          String?  // unidade, kg, etc.
  images            String[]
  active            Boolean  @default(true)

  sellerId          String?
  sellerEmail       String?
  sellerName        String?
  
  // Zone/Area association
  zoneId            String?
  zone              Zone?    @relation(fields: [zoneId], references: [id])
  lat               Float?
  lng               Float?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Service {
  id            String   @id @default(cuid())
  title         String
  description   String?
  price         Float?
  priceType     String   // hora, diaria, servico, orcamento
  serviceType   String?  // limpeza, manutencao, etc.
  images        String[]
  active        Boolean  @default(true)

  providerId    String?
  providerEmail String?
  providerName  String?
  
  // Zone/Area association
  zoneId        String?
  zone          Zone?    @relation(fields: [zoneId], references: [id])
  lat           Float?
  lng           Float?

  rating        Float?   @default(0)
  reviewsCount  Int?     @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Notícias/Informações da comunidade
model News {
  id          String   @id @default(cuid())
  title       String
  content     String
  summary     String?
  imageUrl    String?
  images      String[]
  
  // Autor (Admin/Manager)
  authorId    String
  author      User     @relation("NewsAuthor", fields: [authorId], references: [id])
  
  // Zone/Area association
  zoneId      String?
  zone        Zone?    @relation(fields: [zoneId], references: [id])
  
  isPublished Boolean  @default(true)
  isPinned    Boolean  @default(false)
  publishedAt DateTime?
  
  // Engajamento
  likesCount    Int @default(0)
  commentsCount Int @default(0)
  reportsCount  Int @default(0)
  
  // Relações
  likes    NewsLike[]
  comments NewsComment[]
  reports  NewsReport[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsLike {
  id        String   @id @default(cuid())
  newsId    String
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("UserNewsLikes", fields: [userId], references: [id])
  createdAt DateTime @default(now())
  
  @@unique([newsId, userId])
}

model NewsComment {
  id        String   @id @default(cuid())
  newsId    String
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("UserNewsComments", fields: [userId], references: [id])
  content   String
  
  likesCount Int @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsReport {
  id          String   @id @default(cuid())
  newsId      String
  news        News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("UserNewsReports", fields: [userId], references: [id])
  reason      String
  description String?
  status      String   @default("pending") // pending, reviewed, dismissed
  createdAt   DateTime @default(now())
}


