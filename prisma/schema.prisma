generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String
  role         String   @default("USER")
  authProvider String   @default("local") // "local", "google", "firebase"
  firebaseUid  String?  @unique
  avatarUrl    String?
  bannerUrl    String?
  pixKeyRandom String?
  pixKeyPhone  String?
  pixKeyEmail  String?
  pixKeyCpf    String?
  phone        String?
  cep          String?
  state        String?
  city         String?
  neighborhood String?
  street       String?
  houseNumber  String?
  
  // Residence location
  residenceLat    Float?
  residenceLng    Float?
  residenceZoneId String?
  residenceZone   Zone?    @relation("UserResidenceZone", fields: [residenceZoneId], references: [id])
  
  // Current zone (for tracking)
  currentZoneId   String?
  currentZone     Zone?    @relation("UserCurrentZone", fields: [currentZoneId], references: [id])
  
  // News relations
  authoredNews    News[]        @relation("NewsAuthor")
  newsLikes       NewsLike[]    @relation("UserNewsLikes")
  newsComments    NewsComment[] @relation("UserNewsComments")
  newsReports     NewsReport[]  @relation("UserNewsReports")
  
  // Payment tokens (cartões tokenizados)
  paymentTokens   PaymentToken[]
  orders          Order[]
  
  // Acesso a zonas privadas
  zoneAccesses    UserZoneAccess[]

  // Moderação
  isBlocked      Boolean  @default(false)
  isBanned       Boolean  @default(false)
  blockedReason  String?
  blockedAt      DateTime?
  blockedBy      String?   // ID do gestor que bloqueou/baniu

  // Audit logs criados por este usuário (ações que ELE fez)
  auditLogs      AuditLog[] @relation("AuditLogActor")
  // Audit logs onde este usuário foi o alvo
  auditLogsTarget AuditLog[] @relation("AuditLogTarget")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Zonas/Áreas da comunidade
model Zone {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String?  @default("#14b8a6")
  active      Boolean  @default(true)
  
  // Acesso à zona
  isPublic    Boolean  @default(true)  // Se false, precisa de código para acessar
  accessCode  String?  @unique         // Código de acesso para zonas privadas
  
  // Polygon coordinates in GeoJSON format
  polygonGeojson Json?
  
  // Center point for quick reference
  centerLat   Float?
  centerLng   Float?
  
  // Relations
  residenceUsers User[] @relation("UserResidenceZone")
  currentUsers   User[] @relation("UserCurrentZone")
  products       Product[]
  services       Service[]
  projects       Project[]
  news           News[]
  userAccesses   UserZoneAccess[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Acesso de usuários a zonas privadas
model UserZoneAccess {
  id        String   @id @default(cuid())
  userId    String
  zoneId    String
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone      Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([userId, zoneId])
}

model Project {
  id             String           @id @default(cuid())
  title          String
  shortDescription String?
  description    String?
  category       String?
  status         String           @default("proposed")
  imageUrl       String?
  evidences      String[]         @default([])

  targetAmount   Float            @default(0)
  currentAmount  Float            @default(0)
  minVotes       Int              @default(10)
  votesCount     Int              @default(0)
  fundingDeadline DateTime?

  ownerId        String?
  ownerEmail     String?

  locationAddress String?
  latitude        Float?
  longitude       Float?
  
  // Zone/Area association
  zoneId         String?
  zone           Zone?            @relation(fields: [zoneId], references: [id])

  expensesTotal  Float            @default(0)

  expenses       ProjectExpense[]
  votes          ProjectVote[]
  payments       ProjectPayment[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ProjectExpense {
  id          String   @id @default(cuid())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String

  type        String
  description String?
  cost        Float
  quantity    Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectVote {
  id         String   @id @default(cuid())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String

  userId     String?
  userEmail  String?
  type       String   @default("up") // 'up' ou 'down'

  createdAt  DateTime @default(now())
}

model ProjectPayment {
  id               String   @id @default(cuid())
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId        String

  userId           String?
  userEmail        String?

  amount           Float
  commissionAmount Float?  @default(0)
  paymentMethod    String
  status           String
  isSubscription   Boolean @default(false)
  anonymous        Boolean @default(false)
  
  // Tokenização - apenas IDs/tokens do gateway, nunca dados sensíveis
  transactionId    String?  // ID da transação no gateway (ex: billing_id do Abacate Pay)
  paymentToken     String?  // Token do cartão (se tokenizado pelo gateway)
  gatewayProvider  String?  // Nome do gateway usado (ex: "abacate_pay", "stripe")
  
  // Metadados do pagamento (não sensíveis)
  installments     Int?     @default(1) // Número de parcelas
  last4Digits      String?  // Últimos 4 dígitos do cartão (se aplicável, apenas para exibição)
  cardBrand        String?  // Bandeira do cartão (Visa, Mastercard, etc) - apenas para exibição

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Tokenização de cartões de crédito (opcional - apenas se o gateway suportar)
model PaymentToken {
  id              String   @id @default(cuid())
  userId          String   // Usuário dono do token
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Informações do token (não sensíveis)
  tokenId         String   @unique // ID do token no gateway
  gatewayProvider String   // Nome do gateway (ex: "stripe", "abacate_pay")
  last4Digits     String?  // Últimos 4 dígitos do cartão
  cardBrand       String?  // Bandeira do cartão
  expiryMonth     Int?     // Mês de expiração
  expiryYear      Int?     // Ano de expiração
  isDefault       Boolean  @default(false) // Cartão padrão do usuário
  
  // Metadados
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
}

model Order {
  id              String   @id @default(cuid())
  
  // Cliente
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail       String?
  
  // Produto/Serviço
  productId       String?  // Se for compra de produto
  serviceId       String?  // Se for contratação de serviço
  quantity        Int      @default(1)  // Quantidade comprada
  
  // Valores
  subtotal        Float
  shippingCost    Float    @default(0)
  total           Float
  
  // Entrega
  deliveryMethod  String   // "delivery" ou "pickup"
  deliveryAddress String?  // Endereço de entrega (criptografado)
  
  // Pagamento - apenas tokens
  paymentMethod   String   // "pix", "credit_card", "debit_card", "boleto"
  paymentTokenId  String?  // ID do token de pagamento (se usar token salvo)
  transactionId   String?  // ID da transação no gateway
  gatewayProvider String?  // Nome do gateway usado
  
  // Status
  status          String   @default("pending") // pending, paid, shipped, delivered, cancelled
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
  @@index([status])
}

model AppSettings {
  id             Int      @id @default(1)
  maintenanceMode Boolean @default(false)
  openSignup      Boolean @default(true)
  dailySummary    Boolean @default(true)
  defaultLocale   String  @default("pt-BR")
  updatedAt       DateTime @updatedAt
}

model ApiToken {
  id          String   @id @default(cuid())
  name        String   // Nome do serviço (ex: "Abacate Pay", "Stripe")
  provider    String   // Identificador do provedor (ex: "abacate_pay", "stripe")
  token       String   // Token da API (criptografado em produção)
  description String?  // Descrição opcional
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) // Ordem de exibição
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id                String   @id @default(cuid())
  title             String
  description       String?
  price             Float
  quantityAvailable Float    @default(0)
  category          String?
  condition         String?  // novo, usado_otimo, etc.
  unitType          String?  // unidade, kg, litro
  deliveryTypes     String[] // moto, carro, van, caminhao
  shippingPaidBy    String   @default("buyer") // seller = incluso no preço, buyer = comprador paga
  weightKg          Float?   // peso por unidade em kg (opcional, para estimar custo de frete)
  images            String[]
  active            Boolean  @default(true)

  sellerId          String?
  sellerEmail       String?
  sellerName        String?
  
  // Zone/Area association
  zoneId            String?
  zone              Zone?    @relation(fields: [zoneId], references: [id])
  lat               Float?
  lng               Float?

  discountPercent   Float?   // % de desconto (0-100, null = sem desconto)
  paymentMethods    String[] @default([]) // ["pix", "credit_card", "debit_card", "cash", "transfer"]
  sellerDelivery    Boolean  @default(false) // vendedor realiza a entrega pessoalmente

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Service {
  id            String   @id @default(cuid())
  title         String
  description   String?
  price         Float?   // Mantido para compatibilidade (será removido no futuro)
  priceType     String?  // Mantido para compatibilidade (será removido no futuro)
  pricePerHour  Float?   // Preço por hora (opcional)
  pricePerDay   Float?   // Preço por dia (opcional)
  pricePerService Float? // Preço por serviço completo (opcional)
  serviceType   String?  // limpeza, manutencao, etc.
  images        String[]
  active        Boolean  @default(true)

  providerId    String?
  providerEmail String?
  providerName  String?
  
  // Zone/Area association
  zoneId        String?
  zone          Zone?    @relation(fields: [zoneId], references: [id])
  lat           Float?
  lng           Float?

  rating        Float?   @default(0)
  reviewsCount  Int?     @default(0)

  // Disponibilidade - JSON com estrutura: { "monday": { "available": true, "timeSlots": ["08:00-12:00", "14:00-18:00"] }, ... }
  availabilitySchedule Json?
  
  // Relações
  bookings ServiceBooking[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Notícias/Informações da comunidade
model News {
  id          String   @id @default(cuid())
  title       String
  content     String
  summary     String?
  imageUrl    String?
  images      String[]
  
  // Autor (Admin/Manager)
  authorId    String
  author      User     @relation("NewsAuthor", fields: [authorId], references: [id])
  
  // Zone/Area association
  zoneId      String?
  zone        Zone?    @relation(fields: [zoneId], references: [id])
  
  isPublished Boolean  @default(true)
  isPinned    Boolean  @default(false)
  publishedAt DateTime?
  
  // Engajamento
  likesCount    Int @default(0)
  commentsCount Int @default(0)
  reportsCount  Int @default(0)
  
  // Relações
  likes    NewsLike[]
  comments NewsComment[]
  reports  NewsReport[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsLike {
  id        String   @id @default(cuid())
  newsId    String
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("UserNewsLikes", fields: [userId], references: [id])
  createdAt DateTime @default(now())
  
  @@unique([newsId, userId])
}

model NewsComment {
  id        String   @id @default(cuid())
  newsId    String
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("UserNewsComments", fields: [userId], references: [id])
  content   String
  
  likesCount Int @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsReport {
  id          String   @id @default(cuid())
  newsId      String
  news        News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("UserNewsReports", fields: [userId], references: [id])
  reason      String
  description String?
  status      String   @default("pending") // pending, reviewed, dismissed
  createdAt   DateTime @default(now())
}

model ServiceBooking {
  id              String   @id @default(cuid())
  
  // Relacionamentos
  serviceId       String?
  service         Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  
  // Cliente
  clientId        String?
  clientEmail     String?
  
  // Prestador
  providerId      String?
  providerEmail   String?
  
  // Informações do agendamento
  serviceTitle    String?
  scheduledAt      DateTime
  durationHours   Float    @default(1)
  notes           String?
  clientPriceType String?
  
  // Valores
  totalAmount     Float
  finalAmount     Float?
  commissionAmount Float   @default(0)
  
  // Tempo real trabalhado
  actualWorkedHours   Int?
  actualWorkedMinutes Int?
  
  // Status
  status          String   @default("requested")
  paymentStatus   String   @default("pending")
  
  // Código de confirmação único
  serviceCode     String?
  codeVerified    Boolean  @default(false)
  
  // Localização e hora de início
  startedAt       DateTime?
  clientLat       Float?
  clientLng       Float?
  providerLat     Float?
  providerLng     Float?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([providerEmail])
  @@index([clientEmail])
  @@index([status])
}

// =============================================
// FEATURE FLAGS - Sistema de controle granular
// =============================================

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique // ex: "store_enabled", "projects_enabled", "payments_enabled"
  name        String   // Nome legível: "Loja", "Projetos", "Pagamentos"
  description String?
  
  // Controle global
  enabled     Boolean  @default(true) // Liga/desliga globalmente
  
  // Controle por zona/região
  enabledZoneIds  String[] // IDs das zonas onde está HABILITADO (vazio = todas)
  disabledZoneIds String[] // IDs das zonas onde está DESABILITADO (prioridade sobre enabled)
  
  // Controle por cidade/estado (strings para flexibilidade)
  enabledCities   String[] // Cidades onde está habilitado (vazio = todas)
  disabledCities  String[] // Cidades onde está desabilitado
  enabledStates   String[] // Estados onde está habilitado (vazio = todos)
  disabledStates  String[] // Estados onde está desabilitado
  
  // Controle por role de usuário
  allowedRoles    String[] // Roles que podem usar (vazio = todos). Ex: ["ADMIN", "MANAGER"]
  blockedRoles    String[] // Roles bloqueados
  
  // Controle por IDs específicos de usuários
  allowedUserIds  String[] // Usuários específicos que podem usar
  blockedUserIds  String[] // Usuários específicos bloqueados
  
  // Porcentagem de rollout (0-100)
  rolloutPercentage Int @default(100) // Para rollout gradual
  
  // Metadata
  category    String?  // "module", "feature", "experiment", "maintenance"
  priority    Int      @default(0) // Para ordenação no painel
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([key])
  @@index([enabled])
  @@index([category])
}

// =============================================
// REFRESH TOKENS
// =============================================

model RefreshToken {
  id          String   @id @default(cuid())
  token       String   @unique
  userId      String
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  replacedBy  String?
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// =============================================
// IDEMPOTENCY - Previne pagamentos/ações duplicadas
// =============================================

model IdempotencyKey {
  id            String   @id @default(cuid())
  key           String   @unique
  userId        String?
  method        String
  path          String
  statusCode    Int?
  responseBody  Json?
  
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  
  @@index([key])
  @@index([expiresAt])
}


// =============================================
// MODERAÇÃO DE USUÁRIOS
// =============================================

model BannedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String?
  bannedBy  String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  targetId   String?
  target     User?    @relation("AuditLogTarget", fields: [targetId], references: [id], onDelete: SetNull)
  targetEmail String?
  action     String
  entity     String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@index([createdAt])
}
